; Engine configuration file. The Ashen Crown — Godot 4.7.2 Standard, Compatibility renderer.
config_version=5

[application]

config/name="The Ashen Crown"
config/description="An original pixel-art JRPG."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"
run/max_fps=60
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03, 0.03, 0.05, 1)
config/use_custom_user_dir=true
config/custom_user_dir_name="AshenCrown"

[autoload]

Content="*res://src/autoload/content.gd"
Settings="*res://src/autoload/settings.gd"
Game="*res://src/autoload/game.gd"
Audio="*res://src/autoload/audio.gd"
QA="*res://src/autoload/qa.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://assets/fonts/ashen8.fnt"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)
